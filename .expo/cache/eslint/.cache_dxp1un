 or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\annal\\fitcheck\\src\\TryOnViewer.tsx:46:49\n  44 |   // PanResponder stores callbacks; these refs are read only when gestures fire.\n  45 |   // eslint-disable-next-line react-hooks/refs\n> 46 |   const pan = useMemo(() => PanResponder.create({\n     |                                                 ^\n> 47 |     onStartShouldSetPanResponder: () => true,\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 48 |     onMoveShouldSetPanResponder: () => true,\n     …\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 68 |     onPanResponderTerminate: () => { gesture.current.count = 0; },\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 69 |   }), []);\n     | ^^^^ Passing a ref to a function may read its value during render\n  70 |   function selectPreset(name: string, angle: number) { state.current.targetAngle = nearestAngle(state.current.angle, angle); setPreset(name); }\n  71 |   function reset() { selectPreset('Front', 0); state.current.targetZoom = 1; }\n  72 |   async function initialize(gl: ExpoWebGLRenderingContext) {",["63"],{"kind":"64","justification":"65"},{"kind":"64","justification":"65"},"directive",""]