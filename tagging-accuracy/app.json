{
  "expo": {
    "name": "FitCheck Accuracy",
    "slug": "fitcheck-tagging-accuracy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F7F5FF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F5FF"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow FitCheck to select an outfit photo for on-device AI bias analysis.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
